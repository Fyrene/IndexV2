<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyVersion>0.4.0.2</AssemblyVersion>
		<FileVersion>0.4.0.2</FileVersion>
		<Deterministic>false</Deterministic>
		<RunPostBuildEvent>Always</RunPostBuildEvent>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="GameIcon.jpg" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\..\LibSaber\src\LibSaber.SpaceMarine2\LibSaber.SpaceMarine2.csproj" />
		<ProjectReference Include="..\..\..\..\LibSaber\src\LibSaber\LibSaber.csproj" />
		<ProjectReference Include="..\..\Index.Core\Index.Core.csproj" />
		<ProjectReference Include="..\..\Index.Domain\Index.Domain.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="GameIcon.jpg" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.45" PrivateAssets="all" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="ILRepacker">
		<PropertyGroup>
			<GameProfilesDir>$(SolutionDir)src\Index.App\bin\$(Configuration)\net8.0-windows7.0\GameProfiles</GameProfilesDir>
		</PropertyGroup>

		<MakeDir Directories="$(GameProfilesDir)" />

		<Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFiles="$(GameProfilesDir)\$(TargetName).dll" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFiles="$(GameProfilesDir)\$(TargetName).pdb" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
	</Target>

</Project>
