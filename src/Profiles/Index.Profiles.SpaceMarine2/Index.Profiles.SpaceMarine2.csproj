<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyVersion>0.4.0.2</AssemblyVersion>
		<FileVersion>0.4.0.2</FileVersion>
		<Deterministic>false</Deterministic>
		<RunPostBuildEvent>Always</RunPostBuildEvent>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="GameIcon.jpg" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\..\LibSaber\src\LibSaber.SpaceMarine2\LibSaber.SpaceMarine2.csproj" />
		<ProjectReference Include="..\..\..\..\LibSaber\src\LibSaber\LibSaber.csproj" />
		<ProjectReference Include="..\..\Index.Core\Index.Core.csproj" />
		<ProjectReference Include="..\..\Index.Domain\Index.Domain.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="GameIcon.jpg" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.45">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="ILRepack">
		<Exec Command="mkdir &quot;$(SolutionDir)src\Index.App\bin\$(Configuration)\net8.0-windows7.0\GameProfiles&quot;" ContinueOnError="true" />
		<Exec Command="copy /Y &quot;$(TargetDir)$(TargetName).dll&quot; &quot;$(SolutionDir)src\Index.App\bin\$(Configuration)\net8.0-windows7.0\GameProfiles\$(TargetName).dll&quot;" />
		<Exec Command="copy /Y &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(SolutionDir)src\Index.App\bin\$(Configuration)\net8.0-windows7.0\GameProfiles\$(TargetName).pdb&quot;" />
	</Target>

</Project>



